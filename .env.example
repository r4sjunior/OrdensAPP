# Banco de dados Postgres (Neon ou Vercel Postgres) — guarda só as ordens.
DATABASE_URL="postgres://usuario:senha@host/banco?sslmode=require"
DIRECT_URL="postgres://usuario:senha@host/banco?sslmode=require"

# Clerk (Dashboard do Clerk > API Keys, na sua instância "cordovan-grass")
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_..."
CLERK_SECRET_KEY="sk_..."


# Acesso ao /adm (sorteio da Caixinha de Gela) — defina na Vercel, nunca no código.
ADM_USER=""
ADM_PASSWORD=""

# Só para teste local: antecipa as datas da campanha (não defina na Vercel).
# NEXT_PUBLIC_CAMPAIGN_START="2026-10-01"
# NEXT_PUBLIC_CAMPAIGN_END="2026-12-20"

# Notificações push do APOIO DROP (gere com: npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
