# Banco de dados Postgres (Neon ou Vercel Postgres).
# A Vercel injeta essas duas automaticamente ao conectar um banco Postgres/Neon ao projeto.
DATABASE_URL="postgres://usuario:senha@host/banco?sslmode=require"
DIRECT_URL="postgres://usuario:senha@host/banco?sslmode=require"

# Gere com: openssl rand -base64 33
AUTH_SECRET="cole_aqui_um_valor_aleatorio"

# Credenciais OAuth do Google (Google Cloud Console > APIs e serviços > Credenciais)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
