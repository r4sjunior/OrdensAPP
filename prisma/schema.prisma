generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// O usuário é gerenciado pelo Clerk — aqui guardamos só o Clerk user id (userId).
// Cada registro representa UMA ordem de serviço realizada em uma data.
model Order {
  id        String   @id @default(cuid())
  userId    String // Clerk user id (ex: "user_2abc...")
  date      DateTime @db.Date // dia em que a ordem foi realizada (sem hora)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Presença: cada usuário logado com o app aberto atualiza `lastSeen` periodicamente.
// "Conectados" = usuários com lastSeen recente (ver /api/presence).
model Presence {
  userId   String   @id // Clerk user id
  lastSeen DateTime @default(now())

  @@index([lastSeen])
}

// Campanha "Caixinha de Gela": quantos tickets o usuário depositou como sorte
// para o sorteio. Os tickets ganhos são calculados a partir de Order (ver lib/tickets.ts);
// aqui fica só o total depositado, que não pode ser desfeito.
model LuckDeposit {
  userId    String   @id // Clerk user id
  amount    Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Avatar que o usuário escolheu em /perfil. Só quem adicionou foto aparece com ela
// nos rankings (quem não adicionou fica com um ícone neutro).
model Profile {
  userId    String   @id // Clerk user id
  avatarUrl String
  updatedAt DateTime @updatedAt
}

// Sorteio da roleta. O vencedor é sorteado no servidor ao apertar VALENDO e fica
// gravado junto com a foto e o peso de cada participante naquele momento (auditoria).
// Em `test` o sorteio só aparece no /adm, não na tela de todo mundo.
model Draw {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  spinAt       DateTime // quando a roleta começa a girar (2 min depois do VALENDO)
  test         Boolean   @default(false)
  participants Json // [{ userId, name, imageUrl, luck, weight }]
  winnerIndex  Int
  closedAt     DateTime? // adm tirou o sorteio da tela de todos

  @@index([closedAt])
}

// Aparelho que aceitou receber notificações push (alertas do APOIO DROP com o app fechado).
model PushSubscription {
  endpoint  String   @id
  userId    String // Clerk user id
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Pedido de APOIO DROP: localização de quem pediu e quem atendeu.
model HelpRequest {
  id             String    @id @default(cuid())
  userId         String // Clerk user id de quem pediu
  name           String
  imageUrl       String
  lat            Float
  lng            Float
  accuracy       Float? // metros
  createdAt      DateTime  @default(now())
  acceptedAt     DateTime?
  acceptedById   String?
  acceptedByName String?
  cancelledAt    DateTime?

  @@index([createdAt])
}
