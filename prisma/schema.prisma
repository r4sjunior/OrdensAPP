generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// O usuário é gerenciado pelo Clerk — aqui guardamos só o Clerk user id (userId).
// Cada registro representa UMA ordem de serviço realizada em uma data.
model Order {
  id        String   @id @default(cuid())
  userId    String // Clerk user id (ex: "user_2abc...")
  date      DateTime @db.Date // dia em que a ordem foi realizada (sem hora)
  createdAt DateTime @default(now())

  @@index([userId, date])
}
