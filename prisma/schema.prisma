generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// O usuário é gerenciado pelo Clerk — aqui guardamos só o Clerk user id (userId).
// Cada registro representa UMA ordem de serviço realizada em uma data.
model Order {
  id        String   @id @default(cuid())
  userId    String // Clerk user id (ex: "user_2abc...")
  date      DateTime @db.Date // dia em que a ordem foi realizada (sem hora)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Presença: cada usuário logado com o app aberto atualiza `lastSeen` periodicamente.
// "Conectados" = usuários com lastSeen recente (ver /api/presence).
model Presence {
  userId   String   @id // Clerk user id
  lastSeen DateTime @default(now())

  @@index([lastSeen])
}

// ---------- Rose (Help Rose): base de respostas da equipe técnica ----------

// Uma resposta da Rose (senha, código, configuração, link...).
// media = [{ type, src, name }] (fotos, vídeos, PDFs em /kb ou no Vercel Blob).
model RoseEntry {
  slug      String   @id
  title     String
  category  String
  keywords  String[]
  content   String   @default("")
  media     Json     @default("[]")
  sensitive Boolean  @default(false) // senhas etc. (no Telegram vão só no privado)
  hits      Int      @default(0)
  source    String   @default("novo") // "rose" = veio da Rose antiga
  updatedAt DateTime @updatedAt
}

// Lacuna: o que alguém buscou e a Rose não soube responder.
model RoseMiss {
  query  String   @id // já normalizada (sem acento, minúscula)
  count  Int      @default(1)
  lastAt DateTime @default(now())

  @@index([count])
}
